# Lodekeeper Dashboard Configuration
# Copy to .env and customize

# Server
PORT=7777
HOST=0.0.0.0

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=change-me-to-a-random-64-byte-hex-string

# Session expiry (7 days in seconds)
JWT_EXPIRY=604800

# OpenClaw workspace path (where BACKLOG.md, HEARTBEAT.md etc live)
WORKSPACE_PATH=/home/openclaw/.openclaw/workspace

# GitHub token (optional, for API access beyond gh CLI)
# GITHUB_TOKEN=

# Lodestar repo path
LODESTAR_PATH=/home/openclaw/lodestar

# Set to "true" for local development without HTTPS (cookies won't have Secure flag)
# COOKIE_INSECURE=true
